{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --mode development",
    "demo": "vite --mode demo",
    "build": "vite build --mode production",
    "build:demo": "vite build --mode demo",
    "build:esp8266": "vite build --mode production && npm run optimize:esp8266",
    "optimize:esp8266": "node scripts/optimize-for-esp8266.js",
    "preview": "vite preview",
    "preview:demo": "vite preview --mode demo",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "analyze": "npx vite-bundle-analyzer dist",
    "serve:esp8266": "cd dist && python3 -m http.server 8080"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.10",
    "@vueuse/core": "^13.3.0",
    "pinia": "^3.0.3",
    "reka-ui": "^2.3.1",
    "tailwindcss": "^4.1.10",
    "vue": "^3.5.13",
    "vue-i18n": "^11.1.5",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vue/eslint-config-prettier": "^10.2.0",
    "eslint": "^9.22.0",
    "eslint-plugin-vue": "~10.0.0",
    "globals": "^16.0.0",
    "prettier": "3.5.3",
    "vite": "^6.2.4",
    "vite-plugin-vue-devtools": "^7.7.2"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ]
}